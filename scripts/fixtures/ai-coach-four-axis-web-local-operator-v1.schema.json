{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orider.co.kr/schemas/ai-coach-four-axis-web-local-operator-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "correlationId", "issuedAt", "expiresAt", "consumer", "backend", "operator", "identity", "fixture", "targets"],
  "properties": {
    "schemaVersion": { "const": "ai-coach-four-axis-web-local-operator-v1" },
    "correlationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{15,79}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "statusClean"],
      "properties": {
        "repository": { "const": "miranae/orider-web" },
        "commitSha": { "$ref": "#/definitions/sha" },
        "treeSha": { "$ref": "#/definitions/sha" },
        "statusClean": { "const": true }
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "stageRunId", "checkpointSha256", "leaseGuard"],
      "properties": {
        "repository": { "const": "miranae/orider-g1-web" },
        "commitSha": { "$ref": "#/definitions/sha" },
        "treeSha": { "$ref": "#/definitions/sha" },
        "stageRunId": { "type": "string", "pattern": "^stage_[a-z0-9-]{8,64}$" },
        "checkpointSha256": { "$ref": "#/definitions/digest" },
        "leaseGuard": { "$ref": "#/definitions/leaseGuard" }
      }
    },
    "operator": { "$ref": "#/definitions/operator" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceAccount", "localActor"],
      "properties": {
        "serviceAccount": { "const": "ai-coach-stage-collector@orider-dev.iam.gserviceaccount.com" },
        "localActor": { "type": "string", "format": "email", "maxLength": 320 }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "turns"],
      "properties": {
        "digest": { "const": "sha256:9a2de8d7737e928bf6c6d5a3a26399ad8f95034c3ea6b4ed6746cb5c419e4613" },
        "turns": { "const": [
          { "card": false, "caseId": "track0_load_summary", "providerCalls": 1, "question": "최근 28일 훈련 부하를 요약해줘", "questionCode": "LOAD_SUMMARY", "quotaConsumed": 1 },
          { "card": false, "caseId": "track0_period_compare", "providerCalls": 1, "question": "최근 7일과 이전 7일 훈련을 비교해줘", "questionCode": "PERIOD_COMPARE", "quotaConsumed": 1 },
          { "card": true, "caseId": "pmc_change", "providerCalls": 2, "question": "현재 PMC 변화가 의미하는 것을 설명해줘", "questionCode": "CHANGE", "quotaConsumed": 1 },
          { "card": true, "caseId": "pmc_recovery", "providerCalls": 2, "question": "현재 피로도에서 회복을 어떻게 조절할까?", "questionCode": "RECOVERY", "quotaConsumed": 1 },
          { "card": true, "caseId": "rider_profile", "providerCalls": 2, "question": "내 라이더 유형과 강점을 설명해줘", "questionCode": "PROFILE", "quotaConsumed": 1 },
          { "card": true, "caseId": "rider_duration_priority", "providerCalls": 2, "question": "어떤 파워 지속시간을 우선 훈련해야 해?", "questionCode": "DURATION_PRIORITY", "quotaConsumed": 1 },
          { "card": true, "caseId": "progress_needs_checkin", "providerCalls": 0, "question": "선택한 처방에서 우선 확인할 항목은 뭐야?", "questionCode": "PRIORITY", "quotaConsumed": 0 },
          { "card": true, "caseId": "progress_selected_evidence", "providerCalls": 0, "question": "선택한 처방의 근거를 설명해줘", "questionCode": "SELECTED_EVIDENCE", "quotaConsumed": 0 },
          { "card": true, "caseId": "ride_hardest_section", "providerCalls": 1, "question": "이 코스에서 가장 어려운 구간은 어디야?", "questionCode": "HARDEST_SECTION", "quotaConsumed": 1 },
          { "card": true, "caseId": "ride_personal_pacing", "providerCalls": 1, "question": "내 능력에 맞는 코스 페이스를 알려줘", "questionCode": "PERSONAL_PACING", "quotaConsumed": 1 }
        ] }
      }
    },
    "targets": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "$ref": "#/definitions/baselineTarget" },
        "candidate": { "$ref": "#/definitions/candidateTarget" }
      }
    }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "leaseGuard": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "relativePath", "sha256"],
      "properties": {
        "repository": { "const": "miranae/orider-g1-web" },
        "commitSha": { "$ref": "#/definitions/sha" },
        "treeSha": { "$ref": "#/definitions/sha" },
        "relativePath": { "const": "scripts/assert-ai-coach-local-stage-lease.mjs" },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["osAccount", "gitAuthor", "cloudAccount"],
      "properties": {
        "osAccount": { "type": "string", "minLength": 1, "maxLength": 320 },
        "gitAuthor": { "type": "string", "minLength": 1, "maxLength": 320 },
        "cloudAccount": { "type": "string", "format": "email", "maxLength": 320 }
      }
    },
    "candidateTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "taggedUrl", "targetFingerprint", "tag", "revision", "imageDigest", "stageRunId"],
      "properties": {
        "environment": { "const": "tagged-stage-candidate" },
        "taggedUrl": { "type": "string", "format": "uri" },
        "targetFingerprint": { "$ref": "#/definitions/digest" },
        "tag": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "revision": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "imageDigest": { "$ref": "#/definitions/digest" },
        "stageRunId": { "type": "string", "pattern": "^stage_[a-z0-9-]{8,64}$" }
      }
    },
    "baselineTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "taggedUrl", "targetFingerprint", "tag", "revision", "imageDigest", "stageRunId", "productionAuditDigest"],
      "properties": {
        "environment": { "const": "tagged-stage-baseline" },
        "taggedUrl": { "type": "string", "format": "uri" },
        "targetFingerprint": { "$ref": "#/definitions/digest" },
        "tag": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "revision": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "imageDigest": { "$ref": "#/definitions/digest" },
        "stageRunId": { "type": "string", "pattern": "^stage_[a-z0-9-]{8,64}$" },
        "productionAuditDigest": { "$ref": "#/definitions/digest" }
      }
    }
  }
}
