{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orider.co.kr/schemas/ai-coach-four-axis-web-stage-baseline-evidence-v3.schema.json",
  "title": "AI Coach four-axis Web stage baseline evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactName",
    "repository",
    "commitSha",
    "workflowPath",
    "dispatch",
    "targets",
    "staticEvidence",
    "browserEvidence",
    "liveComparison",
    "privacyScan"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-coach-four-axis-web-stage-baseline-evidence-v3"
    },
    "artifactName": {
      "type": "string",
      "pattern": "^ai-coach-four-axis-web-evidence-[0-9a-f]{40}-[a-z0-9][a-z0-9-]{15,79}$"
    },
    "repository": {
      "const": "miranae/orider-web"
    },
    "commitSha": {
      "$ref": "#/$defs/sha"
    },
    "workflowPath": {
      "const": ".github/workflows/ai-coach-four-axis-evidence.yml"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "staticEvidence": {
      "$ref": "#/$defs/staticEvidence"
    },
    "browserEvidence": {
      "$ref": "#/$defs/browserEvidence"
    },
    "liveComparison": {
      "$ref": "#/$defs/liveComparison"
    },
    "privacyScan": {
      "$ref": "#/$defs/privacyScan"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hexDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha"
      ],
      "properties": {
        "repository": {
          "const": "miranae/orider-web"
        },
        "sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflowPath",
        "headSha",
        "runId",
        "runAttempt",
        "actor",
        "event"
      ],
      "properties": {
        "repository": {
          "const": "miranae/orider-g1-web"
        },
        "workflowPath": {
          "const": ".github/workflows/ai-coach-promotion-gate.yml"
        },
        "headSha": {
          "$ref": "#/$defs/sha"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "event": {
          "const": "workflow_dispatch"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "runId",
        "runAttempt",
        "actor",
        "event"
      ],
      "properties": {
        "repository": {
          "const": "miranae/orider-web"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "workflow_dispatch"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlationId",
        "requestSha256",
        "expiresAt",
        "consumer",
        "orchestrator",
        "workflow"
      ],
      "properties": {
        "correlationId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{15,79}$"
        },
        "requestSha256": {
          "$ref": "#/$defs/digest"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "consumer": {
          "$ref": "#/$defs/consumer"
        },
        "orchestrator": {
          "$ref": "#/$defs/orchestrator"
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        }
      }
    },
    "baselineTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "targetFingerprint",
        "tag",
        "revision",
        "imageDigest",
        "stageRunId",
        "productionAuditDigest"
      ],
      "properties": {
        "environment": {
          "const": "tagged-stage-baseline"
        },
        "targetFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "imageDigest": {
          "$ref": "#/$defs/digest"
        },
        "stageRunId": {
          "type": "string",
          "pattern": "^stage_[a-z0-9-]{8,64}$"
        },
        "productionAuditDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "targetFingerprint",
        "tag",
        "revision",
        "imageDigest",
        "stageRunId"
      ],
      "properties": {
        "environment": {
          "const": "tagged-stage-candidate"
        },
        "targetFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "imageDigest": {
          "$ref": "#/$defs/digest"
        },
        "stageRunId": {
          "type": "string",
          "pattern": "^stage_[a-z0-9-]{8,64}$"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/baselineTarget"
        },
        "candidate": {
          "$ref": "#/$defs/candidateTarget"
        }
      }
    },
    "testFileSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src/features/coach/aiCoachFourAxisWebEvidence.test.ts",
        "src/features/coach/CoachPmcInsightCard.test.tsx",
        "src/services/coachPmcInsightContract.test.ts",
        "src/features/coach/CoachRiderInsightCard.test.tsx",
        "src/features/fitness/riderInsightParity.test.ts",
        "src/features/coach/CoachPrescription.test.tsx",
        "src/services/coachProgressPlannerContract.test.ts",
        "src/features/courses/CourseRidePlanSection.test.tsx",
        "src/services/coachRidePlanContract.test.ts"
      ],
      "properties": {
        "src/features/coach/aiCoachFourAxisWebEvidence.test.ts": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/features/coach/CoachPmcInsightCard.test.tsx": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/services/coachPmcInsightContract.test.ts": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/features/coach/CoachRiderInsightCard.test.tsx": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/features/fitness/riderInsightParity.test.ts": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/features/coach/CoachPrescription.test.tsx": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/services/coachProgressPlannerContract.test.ts": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/features/courses/CourseRidePlanSection.test.tsx": {
          "$ref": "#/$defs/hexDigest"
        },
        "src/services/coachRidePlanContract.test.ts": {
          "$ref": "#/$defs/hexDigest"
        }
      }
    },
    "staticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testFiles",
        "testFileSha256",
        "results",
        "assertionReceiptDigests"
      ],
      "properties": {
        "testFiles": {
          "const": [
            "src/features/coach/aiCoachFourAxisWebEvidence.test.ts",
            "src/features/coach/CoachPmcInsightCard.test.tsx",
            "src/services/coachPmcInsightContract.test.ts",
            "src/features/coach/CoachRiderInsightCard.test.tsx",
            "src/features/fitness/riderInsightParity.test.ts",
            "src/features/coach/CoachPrescription.test.tsx",
            "src/services/coachProgressPlannerContract.test.ts",
            "src/features/courses/CourseRidePlanSection.test.tsx",
            "src/services/coachRidePlanContract.test.ts"
          ]
        },
        "testFileSha256": {
          "$ref": "#/$defs/testFileSha256"
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed",
            "skipped",
            "todo"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 14
            },
            "failed": {
              "const": 0
            },
            "skipped": {
              "const": 0
            },
            "todo": {
              "const": 0
            }
          }
        },
        "assertionReceiptDigests": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "browserSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "componentName",
        "harnessPath",
        "viewportCssPx",
        "deviceScaleFactor",
        "cssZoomPercent",
        "rootClientWidth",
        "rootScrollWidth",
        "labelledRootCount",
        "namedInteractiveCount",
        "liveRegionObservedCount",
        "tabStartDigest",
        "tabSteps",
        "expectedFocusOrderDigest",
        "observedFocusOrderDigest",
        "focusOrderMismatchCount",
        "questionControlOrderDigest",
        "focusedQuestionOrdinal",
        "focusedQuestionControlDigest",
        "tabindexMinusOneQuestionCount",
        "skippedQuestionControlCount",
        "keyboardActivations",
        "domDigest",
        "ariaSnapshotDigest",
        "screenshotDigest",
        "measurementReceiptDigest"
      ],
      "properties": {
        "surface": {
          "enum": [
            "pmc",
            "rider",
            "progress",
            "ride"
          ]
        },
        "componentName": {
          "enum": [
            "CoachPmcInsightCard",
            "CoachRiderInsightCard",
            "CoachPrescription",
            "CourseRidePlanSection"
          ]
        },
        "harnessPath": {
          "const": "/scripts/evidence/four-axis/index.html"
        },
        "viewportCssPx": {
          "const": 320
        },
        "deviceScaleFactor": {
          "const": 2
        },
        "cssZoomPercent": {
          "const": 200
        },
        "rootClientWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 320
        },
        "rootScrollWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 320
        },
        "labelledRootCount": {
          "type": "integer",
          "minimum": 1
        },
        "namedInteractiveCount": {
          "type": "integer",
          "minimum": 1
        },
        "liveRegionObservedCount": {
          "type": "integer",
          "minimum": 1
        },
        "tabStartDigest": {
          "$ref": "#/$defs/digest"
        },
        "tabSteps": {
          "type": "integer",
          "minimum": 1
        },
        "expectedFocusOrderDigest": {
          "$ref": "#/$defs/digest"
        },
        "observedFocusOrderDigest": {
          "$ref": "#/$defs/digest"
        },
        "focusOrderMismatchCount": {
          "const": 0
        },
        "questionControlOrderDigest": {
          "$ref": "#/$defs/digest"
        },
        "focusedQuestionOrdinal": {
          "const": 0
        },
        "focusedQuestionControlDigest": {
          "$ref": "#/$defs/digest"
        },
        "tabindexMinusOneQuestionCount": {
          "const": 0
        },
        "skippedQuestionControlCount": {
          "const": 0
        },
        "keyboardActivations": {
          "type": "integer",
          "minimum": 1
        },
        "domDigest": {
          "$ref": "#/$defs/digest"
        },
        "ariaSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "screenshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "measurementReceiptDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "browserEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "harnessMode",
        "harnessPath",
        "viewportCssPx",
        "deviceScaleFactor",
        "cssZoomPercent",
        "surfaces"
      ],
      "properties": {
        "engine": {
          "const": "chromium"
        },
        "harnessMode": {
          "const": "evidence"
        },
        "harnessPath": {
          "const": "/scripts/evidence/four-axis/index.html"
        },
        "viewportCssPx": {
          "const": 320
        },
        "deviceScaleFactor": {
          "const": 2
        },
        "cssZoomPercent": {
          "const": 200
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pmc",
            "rider",
            "progress",
            "ride"
          ],
          "properties": {
            "pmc": {
              "$ref": "#/$defs/pmcSurface"
            },
            "rider": {
              "$ref": "#/$defs/riderSurface"
            },
            "progress": {
              "$ref": "#/$defs/progressSurface"
            },
            "ride": {
              "$ref": "#/$defs/rideSurface"
            }
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevisionDigest",
        "projectionDigest",
        "evidenceDigest",
        "sharedFactsDigest"
      ],
      "properties": {
        "sourceRevisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "projectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "sharedFactsDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevisionDigest",
        "projectionDigest",
        "evidenceDigest",
        "sharedFactsDigest",
        "providerCalls",
        "quotaConsumed",
        "userDataWrites"
      ],
      "properties": {
        "sourceRevisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "projectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "sharedFactsDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerCalls": {
          "const": 0
        },
        "quotaConsumed": {
          "const": 0
        },
        "userDataWrites": {
          "const": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "fixtureDigest",
        "requestDigest",
        "httpStatus",
        "latencyMs",
        "providerCalls",
        "quotaConsumed",
        "userDataWrites",
        "card",
        "response",
        "productExecution",
        "receiptDigest"
      ],
      "properties": {
        "caseId": {
          "enum": [
            "track0_load_summary",
            "track0_period_compare",
            "pmc_change",
            "pmc_recovery",
            "rider_profile",
            "rider_duration_priority",
            "progress_needs_checkin",
            "progress_selected_evidence",
            "ride_hardest_section",
            "ride_personal_pacing"
          ]
        },
        "fixtureDigest": {
          "$ref": "#/$defs/digest"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "httpStatus": {
          "const": 200
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "providerCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "quotaConsumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "userDataWrites": {
          "const": 0
        },
        "card": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/card"
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/projection"
        },
        "receiptDigest": {
          "$ref": "#/$defs/digest"
        },
        "productExecution": {
          "$ref": "#/$defs/productExecution"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": [
        {
          "$ref": "#/$defs/observation_track0_load_summary"
        },
        {
          "$ref": "#/$defs/observation_track0_period_compare"
        },
        {
          "$ref": "#/$defs/observation_pmc_change"
        },
        {
          "$ref": "#/$defs/observation_pmc_recovery"
        },
        {
          "$ref": "#/$defs/observation_rider_profile"
        },
        {
          "$ref": "#/$defs/observation_rider_duration_priority"
        },
        {
          "$ref": "#/$defs/observation_progress_needs_checkin"
        },
        {
          "$ref": "#/$defs/observation_progress_selected_evidence"
        },
        {
          "$ref": "#/$defs/observation_ride_hardest_section"
        },
        {
          "$ref": "#/$defs/observation_ride_personal_pacing"
        }
      ],
      "additionalItems": false
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "path",
        "httpStatus",
        "providerCalls",
        "quotaConsumed",
        "userDataWrites",
        "receiptDigest"
      ],
      "properties": {
        "environment": {
          "enum": [
            "tagged-stage-baseline",
            "tagged-stage-candidate"
          ]
        },
        "path": {
          "const": "/v1/coach/status"
        },
        "httpStatus": {
          "const": 200
        },
        "providerCalls": {
          "const": 0
        },
        "quotaConsumed": {
          "const": 0
        },
        "userDataWrites": {
          "const": 0
        },
        "receiptDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "liveComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmups",
        "baseline",
        "candidate",
        "metrics"
      ],
      "properties": {
        "warmups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/warmup"
                },
                {
                  "properties": {
                    "environment": {
                      "const": "tagged-stage-baseline"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/warmup"
                },
                {
                  "properties": {
                    "environment": {
                      "const": "tagged-stage-candidate"
                    }
                  }
                }
              ]
            }
          ],
          "additionalItems": false
        },
        "baseline": {
          "$ref": "#/$defs/observations"
        },
        "candidate": {
          "$ref": "#/$defs/observations"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baselineP95Ms",
            "candidateP95Ms",
            "baselineFiveXx",
            "candidateFiveXx",
            "measuredTurnsPerTarget"
          ],
          "properties": {
            "baselineP95Ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000
            },
            "candidateP95Ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30000
            },
            "baselineFiveXx": {
              "const": 0
            },
            "candidateFiveXx": {
              "const": 0
            },
            "measuredTurnsPerTarget": {
              "const": 10
            }
          }
        }
      }
    },
    "privacyScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches",
        "scannedBytes"
      ],
      "properties": {
        "matches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finalArtifact",
            "renderedDom",
            "networkUrls",
            "networkBodies",
            "testLogs",
            "providerSidecars"
          ],
          "properties": {
            "finalArtifact": {
              "const": 0
            },
            "renderedDom": {
              "const": 0
            },
            "networkUrls": {
              "const": 0
            },
            "networkBodies": {
              "const": 0
            },
            "testLogs": {
              "const": 0
            },
            "providerSidecars": {
              "const": 0
            }
          }
        },
        "scannedBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "productExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionPath",
        "cardPath",
        "requestKey",
        "questionStatus",
        "cardStatus",
        "providerCallsObserved",
        "providerLedgerCount",
        "turnLedgerCount",
        "userDataWrites",
        "questionResponseDigest",
        "cardResponseDigest"
      ],
      "properties": {
        "questionPath": {
          "const": "/v1/coach/respond"
        },
        "cardPath": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "/v1/coach/insights/pmc",
            "/v1/coach/insights/rider",
            "/v1/coach/change-proposals",
            "/v1/coach/ride-plan"
          ]
        },
        "requestKey": {
          "$ref": "#/$defs/hexDigest"
        },
        "questionStatus": {
          "const": 200
        },
        "cardStatus": {
          "type": [
            "integer",
            "null"
