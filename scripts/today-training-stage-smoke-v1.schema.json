{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orider.co.kr/schemas/today-training-stage-smoke-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commitSha", "projectId", "createdAt", "auth", "decision", "executionOff", "executionEligible", "reserve", "list"],
  "properties": {
    "schemaVersion": { "const": "today-training-stage-smoke-v1" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,62}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "auth": { "type": "object", "additionalProperties": false, "required": ["idToken", "appCheck"], "properties": { "idToken": { "const": true }, "appCheck": { "const": true } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["status", "schemaVersion", "providerCalls", "quotaConsumed"], "properties": { "status": { "const": 200 }, "schemaVersion": { "const": "today-training-decision-v1" }, "providerCalls": { "const": 0 }, "quotaConsumed": { "const": 0 } } },
    "executionOff": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": 404 } } },
    "executionEligible": { "$ref": "#/$defs/disciplineStatus" },
    "reserve": { "type": "object", "additionalProperties": false, "required": ["status", "reservationMode", "executionIdDigest", "scheduledSessionIdDigest"], "properties": { "status": { "const": 200 }, "reservationMode": { "enum": ["fresh", "reused"] }, "executionIdDigest": { "$ref": "#/$defs/digest" }, "scheduledSessionIdDigest": { "$ref": "#/$defs/digest" } } },
    "list": { "type": "object", "additionalProperties": false, "required": ["status", "discipline", "containsReserved"], "properties": { "status": { "const": 200 }, "discipline": { "$ref": "#/$defs/discipline" }, "containsReserved": { "const": true } } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "discipline": { "enum": ["bike", "run", "swim"] },
    "disciplineStatus": { "type": "object", "additionalProperties": false, "required": ["status", "discipline"], "properties": { "status": { "const": 200 }, "discipline": { "$ref": "#/$defs/discipline" } } }
  }
}
