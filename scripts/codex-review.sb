(version 1)
(deny default)

(allow process*)
(allow signal (target children))
(allow syscall*)
(allow mach*)
(allow ipc*)
(allow sysctl-read)

(allow file-read* file-test-existence file-map-executable
  (literal "/")
  (subpath "/System")
  (subpath "/Library/Apple")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/dev")
  (subpath (param "CODEX_RUNTIME_DIR"))
  (literal (param "CODEX_BIN"))
  (subpath (param "REVIEW_DIR")))

; Only the Codex process may authenticate, persist ephemeral runtime state, or use the network.
; Tool children inherit the sandbox but can read only REVIEW_DIR and system/runtime binaries.
(with-filter (process-path (param "CODEX_BIN"))
  (allow network*)
  (allow file-read* file-test-existence
    (subpath (param "REVIEW_TMP"))
    (literal (param "CODEX_AUTH_FILE"))))

(allow file-read-metadata file-test-existence
  (literal "/etc")
  (literal "/tmp")
  (literal "/var")
  (path-ancestors (param "CODEX_AUTH_FILE"))
  (path-ancestors (param "CODEX_BIN"))
  (path-ancestors (param "REVIEW_DIR"))
  (path-ancestors (param "REVIEW_LOG"))
  (path-ancestors (param "REVIEW_OUT"))
  (path-ancestors (param "REVIEW_TMP")))

(allow file-write* file-test-existence
  (literal "/dev/dtracehelper")
  (literal "/dev/null")
  (literal "/dev/zero")
  (subpath "/dev/fd")
  (subpath (param "REVIEW_TMP"))
  (literal (param "REVIEW_OUT"))
  (literal (param "REVIEW_LOG")))

(allow file-ioctl (literal "/dev/dtracehelper"))
